{
    "name": "invoiceplane/invoiceplane",
    "description": "InvoicePlane is a self-hosted open source application for managing your invoices, clients and payments",
    "homepage": "https://invoiceplane.com",
    "license": "MIT",
    "type": "project",
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "require": {
        "endroid/qr-code": "^4.8.5",
        "guzzlehttp/guzzle": "^7.10",
        "illuminate/collections": "^10.0 | ^11.0",
        "league/oauth2-client": "^2.8",
        "moneyphp/money": "^4.8",
        "mpdf/mpdf": "^8.2.7",
        "paragonie/random_compat": "^2.0.21",
        "phpmailer/phpmailer": "^6.12",
        "pocketarc/codeigniter": "3.3",
        "setasign/fpdf": "^1.8.6",
        "setasign/fpdi": "^2.6.4",
        "smhg/sepa-qr-data": "^1.2",
        "stripe/stripe-php": "^14.10",
        "vlucas/phpdotenv": "^5.6.3"
    },
    "require-dev": {
        "filp/whoops": "^2.18.4",
        "laravel/pint": "^1.27.1",
        "phpunit/phpunit": "^10.5 | ^11.5",
        "rector/rector": "^2.3.6",
        "squizlabs/php_codesniffer": "^3.13.5",
        "symfony/var-dumper": "^6.4.32"
    },
    "scripts": {
        "check": [
            "rector",
            "phpcs",
            "pint"
        ],
        "rector": [
            "Composer\\Config::disableProcessTimeout",
            "vendor/bin/rector process"
        ],
        "phpcs": [
            "Composer\\Config::disableProcessTimeout",
            "vendor/bin/phpcbf -p --standard=phpcs.xml"
        ],
        "pint": [
            "Composer\\Config::disableProcessTimeout",
            "vendor/bin/pint"
        ],
        "test:php": "vendor/bin/phpunit --configuration phpunit.xml.dist"
    },
    "autoload": {
        "psr-4": {
            "Core\\": "application/modules/core/src/",
            "Modules\\Clients\\": "application/modules/clients/",
            "Modules\\CustomFields\\": "application/modules/custom_fields/",
            "Modules\\CustomValues\\": "application/modules/custom_values/",
            "Modules\\Dashboard\\": "application/modules/dashboard/",
            "Modules\\EmailTemplates\\": "application/modules/email_templates/",
            "Modules\\Families\\": "application/modules/families/",
            "Modules\\Filter\\": "application/modules/filter/",
            "Modules\\Guest\\": "application/modules/guest/",
            "Modules\\Import\\": "application/modules/import/",
            "Modules\\Integrations\\": "application/modules/integrations/",
            "Modules\\InvoiceGroups\\": "application/modules/invoice_groups/",
            "Modules\\Invoices\\": "application/modules/invoices/",
            "Modules\\Layout\\": "application/modules/layout/",
            "Modules\\Mailer\\": "application/modules/mailer/",
            "Modules\\PaymentMethods\\": "application/modules/payment_methods/",
            "Modules\\Payments\\": "application/modules/payments/",
            "Modules\\Products\\": "application/modules/products/",
            "Modules\\Projects\\": "application/modules/projects/",
            "Modules\\Quotes\\": "application/modules/quotes/",
            "Modules\\Reports\\": "application/modules/reports/",
            "Modules\\Sessions\\": "application/modules/sessions/",
            "Modules\\Settings\\": "application/modules/settings/",
            "Modules\\Setup\\": "application/modules/setup/",
            "Modules\\Tasks\\": "application/modules/tasks/",
            "Modules\\TaxRates\\": "application/modules/tax_rates/",
            "Modules\\Units\\": "application/modules/units/",
            "Modules\\Upload\\": "application/modules/upload/",
            "Modules\\UserClients\\": "application/modules/user_clients/",
            "Modules\\Users\\": "application/modules/users/",
            "Modules\\Welcome\\": "application/modules/welcome/"
        },
        "files": [
            "bootstrap/autoload.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
